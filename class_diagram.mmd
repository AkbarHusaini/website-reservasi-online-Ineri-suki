    %% ================= MODEL (M_) =================
    namespace Database_Models {
        class M_User {
            +int id
            +varchar name
            +varchar email
            +varchar password
            +varchar phone
            +enum role
            +timestamp created_at
            +timestamp updated_at
            +create()
            +findByEmail()
            +findById()
            +update()
            +delete()
        }

        class M_Admin {
            +int id
            +varchar name
            +varchar email
            +varchar password
            +timestamp created_at
            +create()
            +findByEmail()
            +findById()
            +update()
            +delete()
        }

        class M_Category {
            +int id
            +varchar slug
            +varchar label
            +create()
            +findAll()
            +findById()
            +update()
            +delete()
        }

        class M_MenuItem {
            +int id
            +int category_id
            +varchar name
            +text description
            +decimal price
            +varchar img_path
            +varchar badge
            +varchar badge_class
            +boolean is_available
            +int sort_order
            +timestamp created_at
            +create()
            +findAll()
            +findByCategory()
            +findById()
            +update()
            +delete()
        }

        class M_Package {
            +int id
            +varchar name
            +text description
            +decimal price
            +varchar img_path
            +varchar badge
            +varchar badge_class
            +int min_pax
            +int max_pax
            +boolean is_available
            +int sort_order
            +timestamp created_at
            +create()
            +findAll()
            +findById()
            +update()
            +delete()
        }

        class M_Table {
            +int id
            +varchar table_number
            +int capacity
            +boolean is_active
            +create()
            +findAll()
            +findAvailable()
            +update()
            +delete()
        }

        class M_Reservation {
            +int id
            +int user_id
            +int table_id
            +date reservation_date
            +time start_time
            +time end_time
            +int guest_count
            +text notes
            +enum status
            +timestamp created_at
            +create()
            +findByUserId()
            +findAll()
            +updateStatus()
            +delete()
        }

        class M_Order {
            +int id
            +int user_id
            +int reservation_id
            +decimal total_price
            +enum status
            +enum payment_method
            +text notes
            +timestamp created_at
            +timestamp updated_at
            +create()
            +findByUserId()
            +findAll()
            +updateStatus()
            +delete()
        }

        class M_OrderItem {
            +int id
            +int order_id
            +enum item_type
            +int item_id
            +varchar item_name
            +decimal unit_price
            +int quantity
            +decimal subtotal
            +create()
            +findByOrderId()
            +delete()
        }
    }

    %% ================= CONTROLLER (C_) =================
    namespace Backend_Controllers {
        class C_Auth {
            +register(req, res)
            +login(req, res)
            +checkAuth(req, res)
            +logout(req, res)
        }

        class C_Menu {
            +getAllItems(req, res)
            +getItemById(req, res)
            +createItem(req, res)
            +updateItem(req, res)
            +deleteItem(req, res)
            +getCategories(req, res)
            +getPackages(req, res)
        }

        class C_Order {
            +createOrder(req, res)
            +getMyOrders(req, res)
            +getAllOrders(req, res)
            +updateOrderStatus(req, res)
            +deleteOrder(req, res)
        }

        class C_Payment {
            +processPayment(req, res)
            +getPaymentStatus(req, res)
            +updatePaymentStatus(req, res)
            +getAllPayments(req, res)
        }

        class C_Reservation {
            +createReservation(req, res)
            +getMyReservations(req, res)
            +getAllReservations(req, res)
            +updateReservation(req, res)
            +deleteReservation(req, res)
            +getBookedTables(req, res)
        }

        class C_Table {
            +getAllTables(req, res)
            +createTable(req, res)
            +updateTable(req, res)
            +deleteTable(req, res)
        }
    }

    %% ================= VIEW (V_) USER =================
