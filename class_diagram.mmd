        }
    }

    %% ================= RELATIONSHIPS =================
    %% Views to Controllers
    V_Login ..> C_Auth : POST /login
    V_Register ..> C_Auth : POST /register
    
    V_Menu ..> C_Menu : GET /menu
    V_Home ..> C_Menu : GET /packages
    
    V_AdminMenuManagement ..> C_Menu : POST /menu (Tambah Menu)
    V_AdminMenuManagement ..> C_Menu : PUT /menu (Ubah Menu)
    V_AdminMenuManagement ..> C_Menu : DELETE /menu (Hapus Menu)
    V_AdminCategoryManagement ..> C_Menu : CRUD /category

    V_Cart ..> C_Order : POST /orders
    V_MyOrders ..> C_Order : GET /orders/my
    V_AdminOrderManagement ..> C_Order : GET/PUT /orders

    V_PaymentPage ..> C_Payment : POST /payment
    V_AdminPaymentManagement ..> C_Payment : GET/PUT /payment

    V_Reservation ..> C_Reservation : POST /reservations
    V_Reservation ..> C_Reservation : GET /tables/booked (Cek Ketersediaan Meja)
    
    V_AdminReservationManagement ..> C_Reservation : GET/PUT /reservations

    %% Penjelasan relasi Admin memasukkan data meja baru
    V_AdminTableManagement ..> C_Table : GET /tables (Lihat Daftar Meja)
    V_AdminTableManagement ..> C_Table : POST /tables (Tambah Data Meja Baru)
    V_AdminTableManagement ..> C_Table : PUT /tables (Ubah Data Meja)
    V_AdminTableManagement ..> C_Table : DELETE /tables (Hapus Meja)

    V_AdminDashboard ..> C_Order
    V_AdminDashboard ..> C_Reservation

    %% Controllers to Models
    C_Auth --> M_User
    C_Auth --> M_Admin

    C_Menu --> M_MenuItem
    C_Menu --> M_Category
    C_Menu --> M_Package

    C_Order --> M_Order
    C_Order --> M_OrderItem

    C_Payment --> M_Order

    C_Reservation --> M_Reservation
    C_Reservation --> M_Table

    C_Table --> M_Table
